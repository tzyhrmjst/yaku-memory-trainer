<view class="page">
  <view class="page-container">
    <!-- 筛选栏 -->
    <view class="filter-bar">
      <view
        class="filter-chip {{filter === item.value ? 'filter-chip-active' : ''}}"
        wx:for="{{filters}}"
        wx:key="value"
        data-filter="{{item.value}}"
        bindtap="onFilterTap"
      >
        {{item.label}}
      </view>
    </view>

    <!-- 役种列表 -->
    <view class="yaku-list">
      <view
        class="yaku-card"
        wx:for="{{yakus}}"
        wx:key="id"
        data-yaku-id="{{item.id}}"
        bindtap="onYakuTap"
      >
        <view class="yaku-card-header flex-row">
          <view class="yaku-name">{{item.name}}</view>
          <view class="yaku-name-ja">{{item.nameJa}}</view>
        </view>
        <view class="yaku-card-body">
          <view class="yaku-desc">{{item.description}}</view>
        </view>
        <view class="yaku-card-footer flex-row">
          <view class="tag tag-han">{{item.hanDisplay}}</view>
          <view class="{{item.categoryTagClass}}">{{item.categoryName}}</view>
        </view>
      </view>
    </view>

  </view>
</view>
