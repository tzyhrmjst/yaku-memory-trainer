<view class="page">
  <view class="page-container">
    <!-- 筛选栏 -->
    <view class="filter-bar">
      <view
        class="filter-chip {{filter === item ? 'filter-chip-active' : ''}}"
        wx:for="{{['all', 'basic', 'advanced', 'yakuman']}}"
        wx:key="*this"
        data-filter="{{item}}"
        bindtap="onFilterTap"
      >
        {{item === 'all' ? '全部' : item === 'basic' ? '基础' : item === 'advanced' ? '进阶' : '役满'}}
      </view>
    </view>

    <!-- 役种列表 -->
    <view class="yaku-list">
      <yaku-card
        wx:for="{{yakus}}"
        wx:key="id"
        yakuId="{{item.id}}"
        name="{{item.name}}"
        nameJa="{{item.nameJa}}"
        han="{{item.han}}"
        category="{{item.category}}"
        description="{{item.description}}"
        bind:tap="onYakuTap"
      />
    </view>

  </view>
</view>
