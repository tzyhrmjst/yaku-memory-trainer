<view class="page">
  <!-- 自定义导航栏 -->
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px; height: {{navBarHeight}}px;">
    <view class="nav-content">
      <text class="nav-title">日麻役种牌型记忆助手</text>
    </view>
  </view>

  <!-- 加载状态 -->
  <block wx:if="{{loading}}">
    <view class="loading-container">
      <t-loading theme="circular" size="48rpx" text="加载中..." />
    </view>
  </block>

  <block wx:else>
    <!-- 统计概览 -->
    <view class="stats-section">
      <image class="stats-bg-image" src="/assets/images/mahjong-header.jpg" mode="aspectFill" />
      <view class="stats-header">
        <text class="greeting">日麻役种牌型记忆助手</text>
        <text class="subtitle">役种记忆、牌型理解与算分练习</text>
      </view>

      <view class="stats-overview">
        <text class="overview-title">今日概览</text>
        <view class="overview-row">
          <view class="overview-card">
            <text class="overview-label">今日练习</text>
            <text class="overview-value">{{stats.todayAnswered}}题</text>
          </view>
          <view class="overview-card">
            <text class="overview-label">今日正确率</text>
            <text class="overview-value">{{stats.todayAnswered ? stats.todayAccuracy + '%' : '—'}}</text>
          </view>
        </view>
        <view class="overview-hint">累计答题 {{stats.totalAnswered}} 道</view>
      </view>
    </view>

    <!-- 常用功能 -->
    <view class="entry-section">
      <view class="section-title">常用功能</view>
      <view class="entry-grid">
        <view class="entry-card" bindtap="goQuiz">
          <view class="entry-icon">✏️</view>
          <view class="entry-name">开始练习</view>
          <view class="entry-desc">看牌猜役</view>
        </view>

        <view class="entry-card" bindtap="goScorePractice">
          <view class="entry-icon">🧮</view>
          <view class="entry-name">算分练习</view>
          <view class="entry-desc">番符与点数训练</view>
        </view>

        <view class="entry-card" bindtap="goAnalyzer">
          <view class="entry-icon">🀄</view>
          <view class="entry-name">手牌分析</view>
          <view class="entry-desc">向听与切牌建议</view>
        </view>

        <view class="entry-card" bindtap="goCatalog">
          <view class="entry-icon">📖</view>
          <view class="entry-name">役种图鉴</view>
          <view class="entry-desc">查看全部役种</view>
        </view>
      </view>
    </view>

    <!-- 复习与进度 -->
    <view class="entry-section">
      <view class="section-title">复习与进度</view>
      <view class="entry-grid">
        <view class="entry-card" bindtap="goWrongBook">
          <view class="entry-icon">📝</view>
          <view class="entry-name">错题本</view>
          <view class="entry-desc">{{wrongCount}} 道待复习</view>
        </view>

        <view class="entry-card" bindtap="goProfile">
          <view class="entry-icon">📊</view>
          <view class="entry-name">我的进度</view>
          <view class="entry-desc">学习统计</view>
        </view>
      </view>
    </view>

    <!-- 反馈建议 -->
    <view class="entry-section">
      <button
        class="feedback-btn"
        open-type="contact"
        session-from="home-feedback"
        show-message-card="{{true}}"
        send-message-title="日麻役种牌型记忆助手"
        send-message-path="/pages/index/index"
      >
        <text class="feedback-icon">💬</text>
        <text class="feedback-text">反馈建议</text>
      </button>
    </view>
  </block>
</view>
