<view class="page">
  <!-- 加载 -->
  <block wx:if="{{loading}}">
    <view class="loading-container">
      <t-loading theme="circular" size="48rpx" text="生成复习题单..." />
    </view>
  </block>

  <!-- 空状态 -->
  <block wx:elif="{{empty}}">
    <empty-state text="暂无待复习的错题" subText="去练习中积累错题吧" emoji="🎉">
      <view slot="action" class="mt-24">
        <t-button theme="primary" size="medium" bindtap="onGoHome">去练习</t-button>
      </view>
    </empty-state>
  </block>

  <!-- 答题 -->
  <block wx:elif="{{!completed}}">
    <view class="page-container">
      <!-- 进度 -->
      <view class="quiz-progress-bar">
        <view class="progress-track">
          <view class="progress-fill" style="width: {{progress}}%"></view>
        </view>
        <text class="progress-text">{{currentIndex + 1}} / {{totalQuestions}}</text>
      </view>

      <!-- 题目 -->
      <view class="question-card" wx:if="{{currentQuestion}}">
        <view class="question-header">
          <t-tag theme="warning" variant="outline" size="small">复习模式</t-tag>
          <t-tag wx:if="{{currentQuestion.type === 'tiles-to-yaku'}}" theme="primary" variant="outline" size="small">看牌猜役</t-tag>
          <t-tag wx:else theme="success" variant="outline" size="small">看定义选条件</t-tag>
        </view>

        <!-- 牌面 -->
        <view wx:if="{{currentQuestion.tiles}}" class="tile-section">
          <tile-hand tiles="{{currentQuestion.tiles}}" winTile="{{currentQuestion.winTile}}" />
          <view wx:if="{{currentQuestion.context}}" class="tile-context">
            ⚠️ {{currentQuestion.context}}
          </view>
        </view>

        <!-- 问题 -->
        <view class="question-text">
          {{currentQuestion.question || '这是哪个役种？'}}
        </view>

        <!-- 选项 -->
        <view class="options-list">
          <quiz-option
            wx:for="{{currentQuestion.options}}"
            wx:key="index"
            index="{{index}}"
            text="{{item.text || item}}"
            state="{{item.state || 'normal'}}"
            bind:select="onOptionSelect"
          />
        </view>

        <!-- 解析 -->
        <view wx:if="{{answered}}" class="explanation {{isCorrect ? 'explain-correct' : 'explain-wrong'}}">
          <view class="explain-status">{{isCorrect ? '✓ 回答正确' : '✗ 回答错误'}}</view>
          <view class="explain-text">{{explanation}}</view>
        </view>

        <view wx:if="{{answered}}" class="next-btn">
          <t-button theme="primary" size="large" block bindtap="onNext">
            {{currentIndex + 1 >= totalQuestions ? '完成复习' : '下一题'}}
          </t-button>
        </view>
      </view>
    </view>
  </block>

  <!-- 完成 -->
  <block wx:else>
    <view class="page-container">
      <view class="result-card">
        <view class="result-icon">✅</view>
        <view class="result-summary">本次复习完成</view>
        <view class="result-detail">答对 {{correctCount}} / {{totalQuestions}} 题</view>
        <view class="result-actions mt-32">
          <t-button theme="primary" size="large" block bindtap="onRetry">再复一轮</t-button>
          <view class="mt-16">
            <t-button theme="default" size="large" block bindtap="onGoHome">返回首页</t-button>
          </view>
        </view>
      </view>
    </view>
  </block>
</view>
